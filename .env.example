# =============================================================================
# PROJECT RESILIENCE-ALPHA - G6
# Copier en `.env` puis generer de VRAIES valeurs (voir ci-dessous).
# `.env` est gitignore. Le fichier chiffre `secrets/secrets.enc.yaml` (SOPS)
# est la seule version versionnee -> aucun secret en clair dans le livrable.
# =============================================================================

# -- Base de donnees ----------------------------------------------------------
POSTGRES_USER=ra_app
POSTGRES_PASSWORD=CHANGEME_generer_avec_openssl
POSTGRES_DB=resilience

# -- Authentification ---------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=CHANGEME_generer_avec_openssl

# -- Moteur de remediation ----------------------------------------------------
# Token porteur exige par POST /remediation/trigger.
# Seul ml-detector le connait. openssl rand -hex 32
ORCHESTRATOR_TOKEN=CHANGEME_generer_avec_openssl

# -- Supervision --------------------------------------------------------------
GRAFANA_PASSWORD=CHANGEME_generer_avec_openssl

# -- WAF ----------------------------------------------------------------------
# DetectionOnly  : logge sans bloquer (lundi -> mardi, purge des faux positifs)
# On             : bloque reellement (a partir de mercredi, apres recette)
MODSEC_RULE_ENGINE=DetectionOnly

# -- Assistant RAG (profil `ai`) ----------------------------------------------
# PC Hote 32 Go      -> http://host.docker.internal:11434  + llama3.1:8b
# PC Hote 16 Go      -> http://host.docker.internal:11434  + phi3:mini
# 3e PC de delestage -> http://192.168.137.50:11434        + llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini

# -- Reseau du consortium -----------------------------------------------------
# Point d'acces Windows : RESILIENCE-G6 / 192.168.137.0/24
HOST_IP=192.168.137.1
