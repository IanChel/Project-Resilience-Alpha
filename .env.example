# Configuration NON secrete lue par Docker Compose (interpolation dans compose.yaml).
# Les secrets ne passent JAMAIS par .env : ils vivent dans .secrets/ (genere par
# scripts/init_secrets.py, chiffre avec SOPS/age) et sont montes en Docker secrets.
# Copier ce fichier en `.env` (ignore par git) seulement pour changer une valeur.

# Port publie du WAF sur le PC Hote (compose.yaml, service waf ; lu aussi par les scripts
# via scripts/lab_client.py). 8080 est deja pris sur le PC Hote par un service Java, d'ou 8081.
# A l'interieur de la stack, tout continue de parler a waf:8080 : cela ne change rien.
LAB_PORT=8081

# Interface sur laquelle le WAF publie ce port (compose.yaml, service waf).
# 127.0.0.1 : poste local seulement. 192.168.137.1 : point d'acces RESILIENCE-G2, pour
# que le PC Attaquant atteigne le WAF (docs/INSTALL.md, section 6).
LAB_BIND=127.0.0.1

# URL d'Ollama pour le RAG (compose.yaml, service rag ; lue par services/rag/main.py).
# Par defaut le conteneur ollama. Variante PC IA dedie : l'IP verifiee de ce poste,
# par exemple http://192.168.137.3:11434 (docs/INSTALL.md, section 4).
OLLAMA_URL=http://ollama:11434

# Reglages du detecteur ML (compose.yaml, service detector ; lus par services/detector/model.py).
# Se changent sans reconstruire l'image : `docker compose up -d detector` recree le conteneur.
# Calibration et choix des valeurs : docs/05-ML-RAG.md, section "Calibration".
# Observations anormales d'affilee avant d'envoyer une alerte (entier >= 1).
DETECTOR_CONSECUTIVE=3
# nu du OneClassSVM, dans ]0, 1]. Utilise a l'ENTRAINEMENT : relancer `python -m
# services.detector.train` apres l'avoir change (ou passer `--nu` a la commande).
DETECTOR_NU=0.03
