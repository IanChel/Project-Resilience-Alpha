loki.source.file "business" {
  targets = [{__path__ = "/logs/*.jsonl", job = "resilience"}]
  forward_to = [loki.process.business.receiver]
}
loki.process "business" {
  stage.json {
    expressions = {service = "service", event = "event"}
  }
  stage.labels {
    values = {service = "", event = ""}
  }
  forward_to = [loki.write.local.receiver]
}
loki.source.file "waf" {
  targets = [{__path__ = "/waflogs/audit.log", service = "waf", job = "security"}]
  forward_to = [loki.write.local.receiver]
}
// Access log of the WAF itself: its first field is the PEER address, the only source address a client cannot
// forge. Written only when the ban overlay is enabled (compose.ban.yaml); Alloy just waits while it is absent.
loki.source.file "wafaccess" {
  targets = [{__path__ = "/waflogs/access.log", service = "wafaccess", job = "security"}]
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
