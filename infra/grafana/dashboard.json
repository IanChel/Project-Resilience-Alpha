{
  "uid": "resilience",
  "title": "RESILIENCE — preuves métier et SOC",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Transactions réussies",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lab_requests_total{route=\"payments\",status=\"200\"}[1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejets capacité",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lab_capacity_denied_total[10s]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Capacité occupée",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_active_work",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Confinement actif",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_contained",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Chronologie incident",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"detector|remediator|payment|soc\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "SOC : authentification et WAF",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"auth|waf\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}