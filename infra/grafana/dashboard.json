{
  "uid": "resilience",
  "title": "RESILIENCE — preuves métier et SOC",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "panels": [
    {
      "id": 7,
      "title": "État de la capacité",
      "description": "Voyant basé sur les rejets de capacité des 10 dernières secondes. Rouge dès qu'un rejet apparaît ; ce signal de saturation n'est pas le verdict ML direct.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lab_capacity_denied_total[10s]))",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "SAFE — AUCUN REJET RÉCENT"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.000001,
                "to": 1000000000,
                "result": {
                  "color": "red",
                  "index": 1,
                  "text": "INCIDENT — SATURATION DÉTECTÉE"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "yellow",
                  "index": 2,
                  "text": "DONNÉES INDISPONIBLES"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.000001
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 1,
      "title": "Transactions réussies",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lab_requests_total{route=\"payments\",status=\"200\"}[1m]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejets capacité",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lab_capacity_denied_total[10s]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Capacité occupée",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_active_work",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Confinement actif",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_contained",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Chronologie incident",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"detector|remediator|payment|soc\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "SOC : authentification et WAF",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"auth|waf\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
